{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:filebeat:event:1.0.0",
  "title": "Independent telemetry producer event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "timestamp",
    "service",
    "environment",
    "level",
    "message",
    "trace_id",
    "span_id",
    "attributes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "enum": [
        "http.started",
        "http.completed",
        "job.started",
        "job.completed",
        "connector.started",
        "connector.completed"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "demo",
            "backend",
            "celery-worker",
            "connector"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$"
        }
      }
    },
    "environment": {
      "enum": [
        "development",
        "test",
        "staging",
        "production"
      ]
    },
    "level": {
      "enum": [
        "DEBUG",
        "INFO",
        "WARNING",
        "ERROR",
        "CRITICAL"
      ]
    },
    "message": {
      "enum": [
        "operation.started",
        "operation.completed",
        "operation.failed"
      ]
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "not": {
        "const": "00000000000000000000000000000000"
      }
    },
    "span_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "not": {
        "const": "0000000000000000"
      }
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0,
      "maximum": 86400000
    },
    "outcome": {
      "enum": [
        "success",
        "error",
        "unknown"
      ]
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "http_method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "OTHER"
          ]
        },
        "status_code": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "operation": {
          "enum": [
            "health",
            "ingestion",
            "search",
            "llm",
            "oracle",
            "other"
          ]
        },
        "error_code": {
          "enum": [
            "timeout",
            "unavailable",
            "invalid",
            "internal",
            "none"
          ]
        }
      }
    }
  }
}